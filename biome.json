{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "files": {
    "includes": [
      "src/**",
      "test/**",
      "*.config.ts",
      "*.json",
      "!**/migrations",
      "!!**/node_modules",
      "!!**/dist"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": { "level": "error" },
        "noUndeclaredVariables": "error"
      },
      "suspicious": {
        "noUnusedExpressions": "warn"
      },
      "style": {
        "noNamespace": "warn",
        "noCommonJs": "warn",
        "useAsConstAssertion": "warn"
      }
    }
  },
  "javascript": {
    "formatter": {
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "quoteStyle": "single"
    }
  }
}
